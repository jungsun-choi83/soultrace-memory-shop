# 기본값: localhost 전용 예시 이메일 인증. 실제 이메일·고객정보 사용 금지.
SHOP_MODE=demo
HOST=127.0.0.1
PORT=5173
APP_ORIGIN=http://127.0.0.1:5173

# live 모드 연결 시 필요한 값. 브라우저 코드 / Git / HTML에 넣지 마세요.
# SHOP_MODE=live
# NODE_ENV=production
# APP_ORIGIN=https://shop.eternalbeam.com
# HOST=127.0.0.1
# SHOP_AUTH_SECRET=replace_with_output_from_npm_run_keygen
# RESEND_API_KEY=
# EMAIL_FROM=SoulTrace <verified-sender@your-domain.example>
# SOULTRACE_BRIDGE_ORIGIN=https://your-actual-soultrace-api.example
# SOULTRACE_BRIDGE_KEY=scoped-server-to-server-secret-at-least-32-characters
# LIVE_DATA_FLOW_REVIEWED=yes
# AUTH_DB_PATH=/absolute/persistent/private/path/auth.sqlite
# REVIEWED는 운영팀 확인 표시일 뿐, 법률·보안 승인이나 검증을 대신하지 않습니다.
